# TradingAgents Environment Configuration
# ======================================
# Instructions:
# 1. Copy this file to ".env".
# 2. Replace placeholder values with your own keys.
# 3. Restart the CLI/WebUI after changing this file.
#
# Keep ALPACA_USE_PAPER=True while testing. Set it to False only when you
# intentionally want live Alpaca trading.


# ---------------------------------------------------------------------------
# Runtime Paths
# ---------------------------------------------------------------------------

# Optional. Defaults to "eval_results".
TRADINGAGENTS_RESULTS_DIR=eval_results

# Optional. Defaults to tradingagents/dataflows/data_cache.
TRADINGAGENTS_CACHE_DIR=tradingagents/dataflows/data_cache

# Optional. Defaults to ~/.tradingagents/memory/trading_memory.md.
TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md

# Optional. Override selected bundled model prompt templates with Markdown files.
# Keep grouped paths, for example analysts/market_system.md.
# Missing files fall back to tradingagents/prompts/templates.
TRADINGAGENTS_PROMPT_DIR=


# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------

# Supported values:
# openai, local_openai, google, anthropic, xai, minimax, deepseek, qwen, glm,
# openrouter, ollama, azure
LLM_PROVIDER=openai


# ---------------------------------------------------------------------------
# OpenAI and Local OpenAI-Compatible Endpoints
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Web UI access
# ---------------------------------------------------------------------------
# Required before the UI may bind to anything other than localhost. The
# dashboard can start analyses, place live orders, edit the prompts the agents
# run on, and show the API key settings, so a public bind without a password is
# refused at startup rather than served.
WEBUI_USERNAME=trader
WEBUI_PASSWORD=

# ---------------------------------------------------------------------------
# Alpaca MCP server
# ---------------------------------------------------------------------------
# Route broker calls (options order placement, orders, positions, account)
# through Alpaca's official MCP server instead of calling alpaca-py directly.
# The risk gate and the safety guard run before submission either way -- this
# changes the transport, not the safety path -- and any MCP failure falls back
# to the SDK so a broken install cannot halt trading.
#
# The server is fetched on demand with uvx; no separate install step is needed.
# Override the command to pin a local build, e.g. ALPACA_MCP_COMMAND="python -m
# alpaca_mcp_server".
ALPACA_USE_MCP=true
# ALPACA_MCP_COMMAND=uvx alpaca-mcp-server


# Required for OpenAI models and OpenAI web-search data tools.
# Also used by memory embeddings unless OPENAI_USE_LOCAL points embeddings to
# a compatible local endpoint.
OPENAI_API_KEY=your_openai_api_key_here

# Set true to route core LLM and embedding calls to OPENAI_BASE_URL.
# OpenAI web-search tools still require OPENAI_API_KEY because local endpoints
# usually do not support OpenAI Responses web search.
OPENAI_USE_LOCAL=false

# Examples:
# LM Studio: http://localhost:1234/v1
# Ollama OpenAI compatibility: http://localhost:11434/v1
# vLLM OpenAI server: http://localhost:8000/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# Optional embedding model override for memory.
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002


# ---------------------------------------------------------------------------
# Model selection (optional)
# ---------------------------------------------------------------------------
# Override the models without editing source. Required if your provider is not
# OpenAI, since the defaults below are OpenAI model names that other providers
# will reject with a 404.
#
# Example — a hosted OpenAI-compatible endpoint serving open-weight models:
#   LLM_PROVIDER=local_openai
#   DEEP_THINK_LLM=Qwen/Qwen2.5-72B-Instruct
#   QUICK_THINK_LLM=Qwen/Qwen2.5-32B-Instruct
#   LLM_BACKEND_URL=https://your-endpoint/v1
#
# Whichever models you pick must support tool calling: the analysts, the
# research debate, and the trader all reach the market through bound tools.
# Note that most non-OpenAI endpoints serve no embeddings model, in which case
# agent memory disables itself and the run continues without recall.
# DEEP_THINK_LLM=gpt-5.4-mini
# QUICK_THINK_LLM=gpt-5.4-nano
# LLM_BACKEND_URL=


# ---------------------------------------------------------------------------
# Non-OpenAI LLM Providers
# ---------------------------------------------------------------------------

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI Grok
XAI_API_KEY=your_xai_api_key_here

# MiniMax (official OpenAI-compatible endpoint: https://api.minimax.io/v1)
MINIMAX_API_KEY=your_minimax_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Alibaba Qwen via DashScope OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama does not require an API key by default. Use backend_url in the UI/CLI
# or OPENAI_BASE_URL with LLM_PROVIDER=local_openai for OpenAI compatibility.


# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-12-01-preview


# ---------------------------------------------------------------------------
# Trading, Market Data, News, and Macro APIs
# ---------------------------------------------------------------------------

# Alpaca is required for market data and optional order execution.
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_USE_PAPER=True

# ---------------------------------------------------------------------------
# Options Alpha Overlay
# ---------------------------------------------------------------------------

# Master switch. When True, the Options Strategist node is added to the graph
# between the Trader and the risk debate, and approved plans are submitted as
# defined-risk options orders. Requires options trading to be enabled on the
# Alpaca account (paper accounts have it by default).
OPTIONS_TRADING_ENABLED=False

# A neutral (HOLD) equity signal still permits a defined-risk, non-directional
# structure -- an iron condor when implied vol is rich. The strategist prompt
# decides; it returns `none` when there is no premium edge. Set false to make
# the desk stand aside on every neutral signal instead.
OPTIONS_ALLOW_NEUTRAL=true

# Express the view through options alone. With this false, "Place order after
# analysis" also opens a plain equity position alongside the spread, which
# doubles up on the same directional call.
OPTIONS_ONLY_EXECUTION=true

# ---------------------------------------------------------------------------
# Trading horizon
# ---------------------------------------------------------------------------
# Selects the trader persona and the timeframes the technical brief computes:
#
#   swing  (default)  1h / 4h / 1d   multi-day holds, the original behaviour
#   day               5m / 15m / 1h  opening-range and VWAP rules, flat by the
#                                    close, expressed in 1-7 DTE verticals
#   scalp             5m / 15m / 1h  momentum bursts, tighter stops, strict
#                                    spread filter
#
# A note on "scalp": a decision on this system takes minutes, because the
# analysts, researchers and risk team all run first. Real scalping -- seconds,
# queue position, a few ticks -- is not reachable at that latency, and the
# persona says so rather than pretending. It trades the shortest horizon this
# architecture can actually support: bursts lasting roughly 15 minutes to two
# hours.
TRADING_HORIZON=swing

# Who approves a trade the agents decided on.
#
#   approval    (default)  the run stages the decision and stops; nothing
#                          reaches the broker until someone presses Approve on
#                          Positions & Orders
#   autonomous             the desk places it unattended
#
# Both are also selectable per run on the Run Analysis page. The default is
# approval on purpose: unattended execution should be switched on deliberately.
EXECUTION_MODE=approval

# Expiration window scanned in the option chain, in days.
# Keep this comfortably above OPTIONS_CLOSE_DTE (21) or every new spread
# is closed by the next exit-manager tick.
OPTIONS_DTE_MIN=30
OPTIONS_DTE_MAX=45

# --- Exit management for open options structures ---------------------------
# The risk gate bounds what a NEW position may lose. These bound how long a
# position that is already open keeps losing it. Run by
# scripts/manage_positions.py on a timer, not by the agent graph, so a stop
# fires whether or not an analysis happens to be running.
OPTIONS_EXIT_MANAGER_ENABLED=true
# Close once this fraction of the premium has been captured (0.35 = 35%).
OPTIONS_TAKE_PROFIT_PCT=0.35
# Credit structures: stop once the loss reaches this multiple of the credit.
OPTIONS_STOP_LOSS_MULTIPLE=1.5
# Debit structures: stop after losing this fraction of the premium paid. A
# debit spread cannot lose more than it cost, so a credit-style multiple
# could never fire on one.
OPTIONS_DEBIT_STOP_PCT=0.5
# Close this many days before expiry, before gamma dominates. Keep
# OPTIONS_DTE_MIN comfortably ABOVE this value: a spread opened inside the
# window is closed by the very next run of the exit manager.
OPTIONS_CLOSE_DTE=21

# Risk gate limits. OPTIONS_MAX_LOSS_PCT caps the risk-sized loss of a single
# position as a percent of account equity. OPTIONS_MAX_SPREAD_PCT rejects a leg
# whose bid-ask spread is wider than this percent of its mid price.
OPTIONS_MAX_LOSS_PCT=2.0
OPTIONS_MAX_SPREAD_PCT=20.0

# Smallest acceptable best-case/max-loss ratio for a defined-risk structure.
# Bounding the loss is not the same as the trade being worth taking: without
# this a spread collecting $8 against $250 of risk passes every other check.
# Collateralized writes (cash-secured put, covered call) are exempt.
OPTIONS_MIN_REWARD_RISK=0.25

# Cash-secured puts cannot be sized off a to-zero loss, so the equity limit is
# applied to the loss at this adverse move below the short strike instead.
OPTIONS_STRESS_MOVE_PCT=20.0

# Spread units per trade. The risk gate still has the final say.
OPTIONS_MAX_CONTRACTS=1

# IV rank needs history to mean anything. Below this many stored observations
# it is reported to the model but flagged as not yet reliable.
OPTIONS_MIN_IV_HISTORY_DAYS=20


# Finnhub is used for equity news, insider sentiment/transactions, and
# earnings calendar data.
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED is used by the macro analyst.
FRED_API_KEY=your_fred_api_key_here

# CryptoCompare/CoinDesk-compatible news source used for crypto analysis.
COINDESK_API_KEY=your_cryptocompare_api_key_here

# Optional fallback market data source.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
